# ==============================================================================
# LINE Bot 配置 / การตั้งค่า LINE Bot (LINE Bot Configuration)
# ==============================================================================
# LINE Developers Console -> Messaging API -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE Developers Console -> Basic settings -> Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ==============================================================================
# Gemini AI 配置 / การตั้งค่า Gemini AI (Gemini AI Configuration)
# ==============================================================================
# Google AI Studio 获取 API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 主要翻译模型 / โมเดลหลักสำหรับการแปล (推荐 / แนะนำ: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# 备用容错模型 / โมเดลสำรองเมื่อเกิดข้อผิดพลาด
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ==============================================================================
# 服务器配置 / การตั้งค่าเซิร์ฟเวอร์ (Server Configuration)
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
